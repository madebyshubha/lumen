{
  "expo": {
    "name": "Lumen",
    "slug": "lumen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lumen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff3e9"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.lumen.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lumen uses your microphone so you can speak your vibe and journal entries instead of typing.",
        "NSSpeechRecognitionUsageDescription": "Lumen turns your voice into text on-device so you can log how you feel hands-free."
      }
    },
    "android": {
      "package": "com.lumen.app",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.PLACEHOLDER"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lumen uses your microphone so you can speak your vibe and journal entries instead of typing.",
          "speechRecognitionPermission": "Lumen turns your voice into text on-device so you can log how you feel hands-free.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
