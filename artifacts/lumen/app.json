{
  "expo": {
    "name": "Lumen",
    "slug": "lumen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lumen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff3e9"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.lumen.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lumen uses your microphone so you can speak your vibe and journal entries instead of typing.",
        "NSSpeechRecognitionUsageDescription": "Lumen turns your voice into text on-device so you can log how you feel hands-free.",
        "NSHealthShareUsageDescription": "Lumen reads your period dates, heart rate variability, basal body temperature, sleep, and steps so it can confirm ovulation and tune your daily plan to your real recovery.",
        "NSHealthUpdateUsageDescription": "Lumen does not write to Apple Health."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "com.lumen.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_BASAL_BODY_TEMPERATURE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.PLACEHOLDER"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lumen uses your microphone so you can speak your vibe and journal entries instead of typing.",
          "speechRecognitionPermission": "Lumen turns your voice into text on-device so you can log how you feel hands-free.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "@kingstinct/react-native-healthkit",
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
