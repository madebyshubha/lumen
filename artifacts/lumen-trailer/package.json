{
  "name": "@workspace/lumen-trailer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/patch-public-path.mjs && remotion studio src/index.ts --port=$PORT --hostname=0.0.0.0 --no-open --browser=none --public-dir=public",
    "build": "remotion render src/index.ts LumenTrailer out/lumen-trailer.mp4",
    "serve": "node scripts/patch-public-path.mjs && remotion studio src/index.ts --port=$PORT --hostname=0.0.0.0 --no-open --browser=none --public-dir=public",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.260",
    "@remotion/google-fonts": "4.0.260",
    "@remotion/transitions": "4.0.260",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remotion": "4.0.260"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "typescript": "~5.9.2"
  }
}
